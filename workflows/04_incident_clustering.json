{
  "name": "CampusPilot - 04 Campus Incident Clustering Engine",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "incident-check",
        "options": {}
      },
      "id": "node-incident-trigger",
      "name": "Webhook: Incident Scan",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "incident-check"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://localhost:5000/api/incidents",
        "options": {}
      },
      "id": "node-fetch-incidents",
      "name": "Fetch Active Incidents",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const active = $json.incidents || [];\n\n// Group by location and category to detect clusters\nconst clusters = active.map(inc => ({\n  incidentCode: inc.incident_code,\n  title: inc.title,\n  ticketCount: inc.ticket_count,\n  department: inc.assigned_department,\n  severity: inc.severity\n}));\n\nreturn { totalActiveIncidents: clusters.length, clusters };"
      },
      "id": "node-analyze-clusters",
      "name": "Analyze Spatial & Temporal Clusters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Webhook: Incident Scan": {
      "main": [
        [
          {
            "node": "Fetch Active Incidents",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Active Incidents": {
      "main": [
        [
          {
            "node": "Analyze Clusters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
