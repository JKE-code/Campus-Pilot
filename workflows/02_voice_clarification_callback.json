{
  "name": "CampusPilot - 02 Voice Clarification Callback Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-callback",
        "options": {}
      },
      "id": "node-voice-callback",
      "name": "Webhook: Voice Call Completed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "voice-callback"
    },
    {
      "parameters": {
        "jsCode": "const payload = $json.body || $json;\n\n// Extract structured attributes\nconst extracted = payload.extracted_details || {};\nconst trackingId = payload.tracking_id || payload.trackingId;\n\nreturn {\n  trackingId,\n  wing: extracted.wing || 'Wing B',\n  room: extracted.room || 'Room 204',\n  audioDurationSec: payload.duration_seconds || 38,\n  transcript: payload.transcript || 'Student confirmed room and wing on phone.'\n};"
      },
      "id": "node-parse-voice",
      "name": "Extract Call Entities",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5000/api/requests/{{ $json.trackingId }}/action",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "action_type", "value": "start_progress" },
            { "name": "actor_type", "value": "ai_agent" },
            { "name": "notes", "value": "=Enriched location via voice: Wing {{ $json.wing }}, Room {{ $json.room }}" }
          ]
        },
        "options": {}
      },
      "id": "node-update-ticket",
      "name": "Enrich Ticket in Database",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook: Voice Call Completed": {
      "main": [
        [
          {
            "node": "Extract Call Entities",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Call Entities": {
      "main": [
        [
          {
            "node": "Enrich Ticket in Database",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
