{
  "name": "CampusPilot - 06 Human Approvals & Resolution Closure Loop",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "status-update",
        "options": {}
      },
      "id": "node-webhook-status",
      "name": "Webhook: Status Update Received",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "status-update"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.newStatus }}",
              "value2": "resolved"
            }
          ]
        }
      },
      "id": "node-if-resolved",
      "name": "Is Ticket Marked Resolved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "studentFeedbackPrompt",
              "value": "=Your request {{ $json.body.trackingId }} has been marked resolved by staff. Please confirm if the issue has been fixed satisfactorily, or click Reopen if you still experience problems."
            }
          ]
        },
        "options": {}
      },
      "id": "node-send-closure-loop",
      "name": "Trigger Student Confirmation Request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 240]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "auditLogNote",
              "value": "=State transition to {{ $json.body.newStatus }} recorded in audit trail."
            }
          ]
        },
        "options": {}
      },
      "id": "node-log-transition",
      "name": "Log Standard State Transition",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, 380]
    }
  ],
  "connections": {
    "Webhook: Status Update Received": {
      "main": [
        [
          {
            "node": "Is Ticket Marked Resolved?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Ticket Marked Resolved?": {
      "main": [
        [
          {
            "node": "Trigger Student Confirmation Request",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Standard State Transition",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
