{
  "name": "CampusPilot - 01 Intake & Triage Engine",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "campus-intake",
        "options": {}
      },
      "id": "node-webhook-intake",
      "name": "Webhook: Intake Ingestion",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "campus-intake"
    },
    {
      "parameters": {
        "jsCode": "// Triage & Missing Information Analysis\nconst body = $json.body || $json;\n\nconst type = body.type || 'complaint';\nconst category = body.category || 'maintenance';\nconst location = (body.location || '').toLowerCase();\nconst description = (body.description || '').toLowerCase();\nconst callConsent = body.call_consent === true;\n\n// Check if specific room or wing is mentioned\nconst hasRoomNumber = /room\\s*\\d+|room\\s*no|washroom\\s*\\d+|wing\\s*[a-z]|floor\\s*\\d+/i.test(location + ' ' + description);\n\nconst needsVoiceClarification = callConsent && !hasRoomNumber && (category === 'maintenance' || category === 'hostel');\n\nreturn {\n  tracking_id: body.tracking_id,\n  title: body.title,\n  student_name: body.student_name,\n  student_phone: body.student_phone,\n  category,\n  type,\n  location: body.location,\n  needsVoiceClarification,\n  urgency: body.urgency || 'medium'\n};"
      },
      "id": "node-triage-logic",
      "name": "Evaluate Missing Info & Voice Need",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.needsVoiceClarification }}",
              "value2": true
            }
          ]
        }
      },
      "id": "node-if-voice",
      "name": "Needs Clarification Call?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5000/api/voice/trigger-simulated",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "tracking_id", "value": "={{ $json.tracking_id }}" },
            { "name": "extracted_wing", "value": "Wing B" },
            { "name": "extracted_room", "value": "Room 204" },
            { "name": "student_response", "value": "Clarified via automated n8n voice trigger" }
          ]
        },
        "options": {}
      },
      "id": "node-dispatch-voice",
      "name": "Dispatch Outbound Voice Clarification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5000/api/requests/{{ $json.tracking_id }}/action",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "action_type", "value": "start_progress" },
            { "name": "actor_type", "value": "system" },
            { "name": "notes", "value": "Intake validated with complete details. Assigned to department." }
          ]
        },
        "options": {}
      },
      "id": "node-auto-assign",
      "name": "Direct Department Assignment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 400]
    }
  ],
  "connections": {
    "Webhook: Intake Ingestion": {
      "main": [
        [
          {
            "node": "Evaluate Missing Info & Voice Need",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Missing Info & Voice Need": {
      "main": [
        [
          {
            "node": "Needs Clarification Call?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Clarification Call?": {
      "main": [
        [
          {
            "node": "Dispatch Outbound Voice Clarification",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Direct Department Assignment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
