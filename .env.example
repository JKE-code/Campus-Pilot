# ==========================================
# CampusPilot AI Configuration
# ==========================================

# n8n Configuration
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=campuspilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# AI LLM Services (OpenAI / Anthropic / Google Gemini)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Voice Engine (OmniDimension / Retell / Twilio)
VOICE_AGENT_API_KEY=
VOICE_CALLBACK_URL=http://localhost:5678/webhook/voice-callback

# Email / SMTP Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=noreply@hitam.org
