# ==========================================
# CampusPilot AI — Enterprise Environment Template
# ==========================================

# Server & Environment
PORT=5000
NODE_ENV=development
DEMO_MODE=true
CORS_ORIGIN=http://localhost:5000

# Authentication & Security
# WARNING: All historical 'campuspilot_dev_*' keys are burned. Never use them.
# Generate production keys using: openssl rand -hex 32
JWT_SECRET=replace_with_a_cryptographically_secure_random_32_char_secret!
VOICE_WEBHOOK_SECRET=replace_with_a_cryptographically_secure_random_32_char_secret!

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=campuspilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# n8n Automation Engine
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/webhook
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OmniDimension AI Voice Platform
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=266042
OMNIDIM_PHONE_NUMBER=
OMNIDIM_BASE_URL=https://omnidim.io/api/v1

# Transactional Email (Brevo / SendGrid / Amazon SES)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Campus Security" <noreply@campuspilot.internal>
